FROM debian:12.12-slim
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked --mount=type=cache,target=/var/lib/apt/lists,sharing=locked rm -f /etc/apt/apt.conf.d/docker-clean && apt-get update && apt-get install -y --no-install-recommends unbound dnsutils ca-certificates
COPY dns/unbound.conf /etc/unbound/unbound.conf
EXPOSE 53/tcp 53/udp
CMD ["unbound", "-d", "-c", "/etc/unbound/unbound.conf"]
